<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Folder holding NGENUITY's own assemblies; override with -p:NgenuityDir=... -->
    <NgenuityDir Condition="'$(NgenuityDir)' == ''">$(LOCALAPPDATA)\NGENUITY\current</NgenuityDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Protocol types and transport are NGENUITY's own assemblies, so messages match the installed services.
         They are not redistributed: Private=false keeps them out of the output, and Program.cs loads them
         from the user's NGENUITY installation at run time. -->
    <Reference Include="NGENUITY.Common"><HintPath>$(NgenuityDir)/NGENUITY.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Google.FlatBuffers"><HintPath>$(NgenuityDir)/Google.FlatBuffers.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NetMQ"><HintPath>$(NgenuityDir)/NetMQ.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AsyncIO"><HintPath>$(NgenuityDir)/AsyncIO.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NaCl"><HintPath>$(NgenuityDir)/NaCl.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
